# OpenAI（實際金鑰請存於 .env.local）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 32-byte Base64 key used to encrypt credentials saved from the admin UI
CONFIG_ENCRYPTION_KEY=

# 公開網址，用於 LINE Webhook 與 Rich Menu 圖片
NEXT_PUBLIC_APP_URL=http://localhost:3000
